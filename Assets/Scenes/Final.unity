  m_text: "<b><size=18>EL MINERO</size></b>\nPlataformas 2D\n\n<b>DESARROLLO:</b>\nJuana Jaqueline Camarillo Olaez\nGIDS6102-E\n\n<b>UNIVERSIDAD:</b>\nUTNG\n\n<b>DOCENTE:</b>\nGabriel Barr\xF3n Rodr\xEDguez\nCreaci\xF3n de Videojuegos\n\n<b>M\xDASICA Y ARTE:</b>\nHerramientas de IA Asistida\n\n<b>FUENTES:</b>\nPress Start 2P & Pixelify Sans\n(SIL OFL 1.1)\n\n<i>\xA1Felicidades por escapar!</i>"
